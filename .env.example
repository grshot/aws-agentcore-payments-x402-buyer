# Copy to .env (testnet) and/or .env.mainnet, one file per network, and fill in.
# No secrets belong here: wallet and provider credentials stay in AgentCore
# Identity (Coinbase QuickCreate connector). Check with: uv run python -m scripts.check_env

NETWORK=mainnet                 # mainnet | testnet
SEARCH_ENDPOINT=https://api.exa.ai/search   # testnet: https://sandbox.node4all.com/v1/x402-test
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1            # payments regions: us-east-1, us-west-2, eu-central-1, ap-southeast-2

# From `agentcore deploy` and the instrument setup script
PAYMENT_MANAGER_ARN=
PAYMENT_CONNECTOR_ID=
PAYMENT_INSTRUMENT_ID=
PAYMENT_USER_ID=

# App-code policy rule, checked before AgentCore signs anything
MAX_PRICE_PER_CALL_USD=0.01

# Session defaults (budget cap enforced by AgentCore, never visible to the model)
DEFAULT_BUDGET_USD=0.015
SESSION_EXPIRY_MINUTES=15        # minimum allowed is 15
CHAT_SESSION_EXPIRY_MINUTES=60   # a chat waits on a person typing; AgentCore allows 15-480

# Operator ceiling: no session gets a bigger cap, whatever the page or CLI asks for.
# AgentCore has no account-level cap, so the app enforces this one before creating a session.
MAX_SESSION_CAP_USD=0.05
# Deployed: keep the ceiling in SSM Parameter Store instead and change it in the console
# (read on every session, no restart). Takes precedence over MAX_SESSION_CAP_USD.
MAX_SESSION_CAP_SSM_PARAMETER=
